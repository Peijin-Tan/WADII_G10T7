# Copy this file to config.env (same folder) and fill in the values.
# config.env is in .gitignore, so your real keys never get committed.

# MongoDB Atlas connection string (Atlas > Connect > Drivers)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/foodforthought

# Any long random string, used to sign login tokens
# (generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=

# From https://spoonacular.com/food-api/console#Profile
SPOONACULAR_API_KEY=
